    {
      "type": "text",
      "name": "motivation_skills",
      "label": {
        "de": "Bitte beschreibe hier, welche Deiner Fähigkeiten und Erfahrungen Dich besonders für die Teilnahme an diesem Projekt qualifizieren.",
        "en": "Please describe here what skills and experiences you would bring to the project."
      },
      "hint": {
        "de": "Bitte schreibe maximal 5 Sätze pro Projekt, auf das du dich bewerben möchtest.",
        "en": "Please write maximum 5 sentences per project that you are applying to."
      },
      "required": "yes",
      "appearance": "multiline"
    },
    {
      "type": "text",
      "name": "motivation_why",
      "label": {
        "de": "Bitte beschreibe hier, warum Du Dich für dieses Projekt engagieren möchtest.",
        "en": "Please describe here why you want to get involved in this project."
      },
      "hint": {
        "de": "Bitte schreibe maximal 5 Sätze pro Projekt, auf das du dich bewerben möchtest.",
        "en": "Please write maximum 5 sentences per project that you are applying to."
      },
      "required": "yes",
      "appearance": "multiline"
    },
    {
      "type": "select_one past_applications",
      "name": "past_applications",
      "label": {
        "de": "Hast du dich in der Vergangenheit bereits auf CorrelAid-Projekte beworben?",
        "en": "Have you applied to a CorrelAid project in the past?"
      },
      "hint": {
        "de": "Um möglichst vielen Personen die Gelegenheit zu geben, an unseren Projekten teilzunehmen, werden Bewerbungen von bisher unerfolgreichen Personen bei gleicher Eignung bevorzugt behandelt.",
        "en": "In order to give as many people as possible the opportunity to participate in one of our projects, applications of individuals who have unsuccessfully applied in the past are preferred given equal suitability for the project."
      },
      "required": "yes"
    },
    {
      "type": "text",
      "name": "past_applications_details",
      "label": {
        "de": "Bitte gib hier an, für welche Projekte du dich beworben hast, falls du dich noch erinnern kannst.",
        "en": "If you can remember, please specify which project(s) you have applied for."
      },
      "hint": {
        "de": "Grobe Angaben helfen uns auch schon weiter.",
        "en": "Any information is helpful to us."
      },
      "relevant": "${past_applications} = 'not_successful'"
    },
    {
      "type": "end_group"
