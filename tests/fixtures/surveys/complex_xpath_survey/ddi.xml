<?xml version="1.0" ?>
<codeBook xmlns="ddi:codebook:2_5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="ddi:codebook:2_5 https://ddialliance.org/Specification/DDI-Codebook/2.5/XMLSchema/codebook.xsd" version="2.5" xml:lang="en">
  <stdyDscr>
    <citation>
      <titlStmt>
        <titl>complex_xpath_survey</titl>
        <IDNo>complex_xpath_survey</IDNo>
      </titlStmt>
      <prodStmt>
        <prodDate date="2020-01-01">2020-01-01</prodDate>
      </prodStmt>
    </citation>
    <notes type="cdl:setting" subject="default_language">en</notes>
  </stdyDscr>
  <fileDscr ID="F1" URI="data.csv">
    <fileTxt>
      <fileName>data.csv</fileName>
      <dimensns>
        <caseQnty>0</caseQnty>
      </dimensns>
      <fileType>Comma-separated values (CSV)</fileType>
      <format>text/csv</format>
    </fileTxt>
  </fileDscr>
  <dataDscr>
    <varGrp ID="VG_consent_section" name="consent_section" type="section" var="V_consent V_age V_country V_adult_consent V_eligible_participant V_valid_response V_age_category V_complex_validation">
      <txt>Consent and Demographics</txt>
      <concept>Consent and Demographics</concept>
    </varGrp>
    <var ID="V_consent" name="consent" intrvl="discrete" files="F1">
      <qstn responseDomainType="text" seqNo="1">
        <qstnLit>Do you consent to participate?</qstnLit>
      </qstn>
      <concept>Do you consent to participate?</concept>
      <varFormat type="character" schema="other"/>
    </var>
    <var ID="V_age" name="age" intrvl="contin" dcml="0" files="F1">
      <qstn responseDomainType="numeric" seqNo="2">
        <qstnLit>What is your age?</qstnLit>
      </qstn>
      <concept>What is your age?</concept>
      <varFormat type="numeric" schema="other"/>
    </var>
    <var ID="V_country" name="country" intrvl="discrete" files="F1">
      <qstn responseDomainType="text" seqNo="3">
        <qstnLit>What country do you live in?</qstnLit>
      </qstn>
      <concept>What country do you live in?</concept>
      <varFormat type="character" schema="other"/>
    </var>
    <var ID="V_adult_consent" name="adult_consent" intrvl="discrete" files="F1">
      <qstn responseDomainType="text" seqNo="4">
        <qstnLit>Adult consent verification</qstnLit>
        <backward qstn="V_consent V_age"/>
      </qstn>
      <universe clusion="I">Only if “Do you consent to participate?” = “yes” and “What is your age?” ≥ 18</universe>
      <concept>Adult consent verification</concept>
      <varFormat type="character" schema="other"/>
      <notes type="cdl:relevant" subject="xlsform-xpath">selected(${consent}, 'yes') and ${age} &gt;= 18</notes>
    </var>
    <var ID="V_eligible_participant" name="eligible_participant" intrvl="discrete" files="F1">
      <qstn responseDomainType="text" seqNo="5">
        <qstnLit>Eligible participant</qstnLit>
        <backward qstn="V_age V_country"/>
      </qstn>
      <universe clusion="I">Only if “What is your age?” ≥ 18 and (“What country do you live in?” = “USA” or “What country do you live in?” = “Canada”)</universe>
      <concept>Eligible participant</concept>
      <varFormat type="character" schema="other"/>
      <notes type="cdl:relevant" subject="xlsform-xpath">${age} &gt;= 18 and (${country} = 'USA' or ${country} = 'Canada')</notes>
    </var>
    <var ID="V_valid_response" name="valid_response" intrvl="discrete" files="F1">
      <qstn responseDomainType="text" seqNo="6">
        <qstnLit>Valid response check</qstnLit>
        <backward qstn="V_consent V_age"/>
      </qstn>
      <universe clusion="I">Only if not (“Do you consent to participate?” is not answered) and “What is your age?” &gt; 0</universe>
      <concept>Valid response check</concept>
      <varFormat type="character" schema="other"/>
      <notes type="cdl:relevant" subject="xlsform-xpath">not(${consent} = '') and ${age} &gt; 0</notes>
    </var>
    <var ID="V_age_category" name="age_category" intrvl="discrete" files="F1">
      <qstn responseDomainType="text" seqNo="7">
        <qstnLit>Age category</qstnLit>
        <backward qstn="V_age"/>
      </qstn>
      <concept>Age category</concept>
      <varFormat type="character" schema="other"/>
      <notes type="cdl:relevant" subject="xlsform-xpath">if(${age} &gt; 18, true(), false())</notes>
    </var>
    <var ID="V_complex_validation" name="complex_validation" intrvl="discrete" files="F1">
      <qstn responseDomainType="text" seqNo="8">
        <qstnLit>Complex validation test</qstnLit>
        <backward qstn="V_consent V_age V_country"/>
      </qstn>
      <universe clusion="I">Only if “Do you consent to participate?” = “yes” and (“What is your age?” ≥ 18 or “What country do you live in?” = “USA”)</universe>
      <concept>Complex validation test</concept>
      <varFormat type="character" schema="other"/>
      <notes type="cdl:relevant" subject="xlsform-xpath">${consent} = 'yes' and (${age} &gt;= 18 or ${country} = 'USA')</notes>
      <notes type="cdl:constraint" subject="xlsform-xpath">. &gt;= 5 and . &lt;= 100</notes>
    </var>
  </dataDscr>
</codeBook>
