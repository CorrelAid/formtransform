{
  "survey": [
    {
      "type": "begin_group",
      "name": "teilnahme",
      "label": "teilnahme"
    },
    {
      "type": "select_one dauer",
      "name": "dauer",
      "label": "Wie lange kommst du schon zu TestWerk?",
      "required": "yes"
    },
    {
      "type": "select_one haeufigkeit",
      "name": "haeufigkeit",
      "label": "Wie oft kommst du ungefähr?",
      "required": "yes"
    },
    {
      "type": "integer",
      "name": "stunden_gesamt",
      "label": "Ca. wie viele Stunden warst du insgesamt bei TestWerk? (grobe Schätzung reicht)",
      "hint": "z.B. 10, 50, 100..."
    },
    {
      "type": "select_one hauptwerkstatt",
      "name": "hauptwerkstatt",
      "label": "In welcher Werkstatt bist du hauptsächlich?",
      "required": "yes"
    },
    {
      "type": "select_multiple bereiche",
      "name": "bereiche",
      "label": "Welche Bereiche nutzt du überhaupt? (Mehrfachauswahl möglich)"
    },
    {
      "type": "select_one vorwissen",
      "name": "vorwissen",
      "label": "Hattest du vorher schon handwerkliche Erfahrung?",
      "required": "yes"
    },
    {
      "type": "end_group"
    },
    {
      "type": "begin_group",
      "name": "wirkung",
      "label": "wirkung",
      "hint": "Bitte gib an, wie sehr du zustimmst (1 = stimme gar nicht zu, 5 = stimme voll zu):"
    },
    {
      "type": "select_one wohlfuehlen",
      "name": "wohlfuehlen",
      "label": "Ich fühle mich bei TestWerk wohl und akzeptiert.",
      "required": "yes",
      "appearance": "likert"
    },
    {
      "type": "select_one wohlfuehlen",
      "name": "freundschaften",
      "label": "Ich habe bei TestWerk Freund*innen gefunden.",
      "required": "yes",
      "appearance": "likert"
    },
    {
      "type": "select_one wohlfuehlen",
      "name": "eigene_ideen",
      "label": "Ich traue mir zu, eigene Ideen und Projekte umzusetzen.",
      "required": "yes",
      "appearance": "likert"
    },
    {
      "type": "select_one wohlfuehlen",
      "name": "problemloesung",
      "label": "Wenn bei einem Projekt etwas nicht klappt, finde ich eine Lösung.",
      "required": "yes",
      "appearance": "likert"
    },
    {
      "type": "select_one wohlfuehlen",
      "name": "skills_gelernt",
      "label": "Ich habe bei TestWerk handwerkliche Fähigkeiten gelernt.",
      "required": "yes",
      "appearance": "likert"
    },
    {
      "type": "note",
      "name": "beruf_pre_note",
      "label": "Jetzt denk mal an deine berufliche Zukunft:"
    },
    {
      "type": "select_one wohlfuehlen",
      "name": "beruf_pre",
      "label": "Bevor ich zu TestWerk kam, hatte ich eine klare Vorstellung von meiner beruflichen Zukunft.",
      "required": "yes",
      "appearance": "likert"
    },
    {
      "type": "select_one wohlfuehlen",
      "name": "beruf_post",
      "label": "Aktuell habe ich eine klare Vorstellung von meiner beruflichen Zukunft.",
      "required": "yes",
      "appearance": "likert"
    },
    {
      "type": "range",
      "name": "attribution_beruf",
      "label": "Ca. Wie viel Prozent dieser Veränderung geht auf TestWerk zurück?",
      "hint": "0% = gar nicht, 100% = komplett",
      "parameters": "start=0 end=100 step=5",
      "relevant": "${beruf_post} != ${beruf_pre}"
    },
    {
      "type": "end_group"
    },
    {
      "type": "begin_group",
      "name": "erfahrungen",
      "label": "erfahrungen"
    },
    {
      "type": "text",
      "name": "projekte",
      "label": "Was hast du bei TestWerk gemacht oder gebaut? (gerne Beispiele)"
    },
    {
      "type": "text",
      "name": "am_meisten_gebracht",
      "label": "Was hat dir bei TestWerk am meisten gebracht?"
    },
    {
      "type": "text",
      "name": "verbesserungen",
      "label": "Was könnten wir besser machen?"
    },
    {
      "type": "end_group"
    },
    {
      "type": "begin_group",
      "name": "empfehlung",
      "label": "empfehlung"
    },
    {
      "type": "select_one nps_score",
      "name": "nps_score",
      "label": "Würdest du TestWerk Freund*innen empfehlen?",
      "hint": "0 = auf keinen Fall, 10 = auf jeden Fall",
      "required": "yes",
      "appearance": "likert"
    },
    {
      "type": "end_group"
    },
    {
      "type": "begin_group",
      "name": "demografie",
      "label": "demografie"
    },
    {
      "type": "select_one alter",
      "name": "alter",
      "label": "Wie alt bist du? (optional)"
    },
    {
      "type": "select_one geschlecht",
      "name": "geschlecht",
      "label": "Geschlecht (optional)"
    },
    {
      "type": "text",
      "name": "geschlecht_andere",
      "label": "Falls \"Anderes\": Bitte angeben (optional)",
      "relevant": "${geschlecht} = 'andere'"
    },
    {
      "type": "end_group"
    },
    {
      "type": "note",
      "name": "intro_text",
      "label": "Hey! Wir möchten gerne wissen, wie TestWerk für dich ist und was es dir bringt. Deine Antworten sind anonym und helfen uns, unser Angebot zu verbessern. Es gibt keine richtigen oder falschen Antworten - sag einfach deine Meinung!"
    },
    {
      "type": "note",
      "name": "danke",
      "label": "Vielen Dank! Deine Meinung hilft uns sehr weiter!"
    }
  ],
