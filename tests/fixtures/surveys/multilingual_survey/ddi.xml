<?xml version="1.0" ?>
<codeBook xmlns="ddi:codebook:2_5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="ddi:codebook:2_5 https://ddialliance.org/Specification/DDI-Codebook/2.5/XMLSchema/codebook.xsd" version="2.5" xml:lang="en">
  <stdyDscr>
    <citation>
      <titlStmt>
        <titl>multilingual_survey</titl>
        <IDNo>multilingual_survey</IDNo>
      </titlStmt>
      <prodStmt>
        <prodDate date="2020-01-01">2020-01-01</prodDate>
      </prodStmt>
    </citation>
  </stdyDscr>
  <fileDscr ID="F1" URI="data.csv">
    <fileTxt>
      <fileName>data.csv</fileName>
      <dimensns>
        <caseQnty>0</caseQnty>
      </dimensns>
      <fileType>Comma-separated values (CSV)</fileType>
      <format>text/csv</format>
    </fileTxt>
  </fileDscr>
  <dataDscr>
    <varGrp ID="VG_demographics" name="demographics" type="section" var="V_name V_age V_gender">
      <txt>Demographics</txt>
      <txt xml:lang="es">Datos demográficos</txt>
      <concept>Demographics</concept>
    </varGrp>
    <var ID="V_name" name="name" intrvl="discrete" files="F1">
      <qstn responseDomainType="text">
        <preQTxt>Enter your full name</preQTxt>
        <preQTxt xml:lang="es">Ingresa tu nombre completo</preQTxt>
        <qstnLit>What is your name?</qstnLit>
        <qstnLit xml:lang="es">¿Cuál es tu nombre?</qstnLit>
      </qstn>
      <concept>What is your name?</concept>
      <varFormat type="character" schema="other"/>
    </var>
    <var ID="V_age" name="age" intrvl="contin" files="F1">
      <qstn responseDomainType="numeric">
        <qstnLit>What is your age?</qstnLit>
        <qstnLit xml:lang="es">¿Cuál es tu edad?</qstnLit>
      </qstn>
      <concept>What is your age?</concept>
      <varFormat type="numeric" schema="other"/>
    </var>
    <var ID="V_gender" name="gender" intrvl="discrete" files="F1">
      <qstn responseDomainType="category">
        <qstnLit>Gender</qstnLit>
        <qstnLit xml:lang="es">Género</qstnLit>
      </qstn>
      <catgry>
        <catValu>male</catValu>
        <labl>Male</labl>
        <labl xml:lang="es">Masculino</labl>
      </catgry>
      <catgry>
        <catValu>female</catValu>
        <labl>Female</labl>
        <labl xml:lang="es">Femenino</labl>
      </catgry>
      <catgry>
        <catValu>other</catValu>
        <labl>Other</labl>
        <labl xml:lang="es">Otro</labl>
      </catgry>
      <concept>Gender</concept>
      <varFormat type="character" schema="other"/>
    </var>
    <var ID="V_satisfaction" name="satisfaction" intrvl="discrete" files="F1">
      <qstn responseDomainType="category">
        <qstnLit>How satisfied are you?</qstnLit>
        <qstnLit xml:lang="es">¿Qué tan satisfecho estás?</qstnLit>
      </qstn>
      <catgry>
        <catValu>happy</catValu>
        <labl>Very satisfied</labl>
        <labl xml:lang="es">Muy satisfecho</labl>
      </catgry>
      <catgry>
        <catValu>neutral</catValu>
        <labl>Neutral</labl>
        <labl xml:lang="es">Neutral</labl>
      </catgry>
      <catgry>
        <catValu>unhappy</catValu>
        <labl>Not satisfied</labl>
        <labl xml:lang="es">No satisfecho</labl>
      </catgry>
      <concept>How satisfied are you?</concept>
      <varFormat type="character" schema="other"/>
    </var>
  </dataDscr>
