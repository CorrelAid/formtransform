{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://civic-data.de/survey/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "type": "https://civic-data.de/survey/type/",
    "variant": "https://civic-data.de/survey/variant/",
    "composite": "https://civic-data.de/survey/composite/",
    "appearance": "https://civic-data.de/survey/appearance/",
    "convention": "https://civic-data.de/survey/convention/",
    "vocab": "https://civic-data.de/survey/vocab/",
    "meta": "https://civic-data.de/survey/meta/",
    "classes": {
      "@id": "meta:classes",
      "@type": "@json"
    },
    "relations": {
      "@id": "meta:relations",
      "@type": "@json"
    },
    "rule": {
      "@id": "https://civic-data.de/survey/rule",
      "@type": "@json"
    }
  },
  "@graph": [
    {
      "@id": "convention:ddiFields",
      "@type": "GlobalConvention",
      "skos:prefLabel": "Form fields in DDI Codebook",
      "rule": {
        "description": "Where each field of a form (the Instrument model, src/instrument/types.ts) goes in a CDL DDI codebook (formtransform#153): a standard DDI 2.5 element or attribute wherever one fits, a typed note `<notes type=\"cdl:<field>\">` (the XSD's controlled-vocabulary extension point, as in convention:logicMapping) only where DDI 2.5 has none, or a documented loss. A unit test fails when a model field has no entry.",
        "questionText": {
          "preQTxt": "a note row before the question, or a grid's or select_multiple's shared question text",
          "qstnLit": "the label",
          "postQTxt": "the hint shown to respondents with the question",
          "ivuInstr": "guidance_hint (for interviewers and the codebook, not shown)",
          "order": "preQTxt, qstnLit, postQTxt, backward, ivuInstr (XSD order)"
        },
        "backward": "qstn/backward/@qstn lists the IDs of the questions its own relevant refers to (a var, or the varGrp of a select_multiple or other pair).",
        "seqNo": "qstn/@seqNo is the question's position among the form's data questions, from 1; a select_multiple's binaries share their question's.",
        "notes": {
          "default": {
            "type": "cdl:default",
            "on": [
              "var",
              "varGrp"
            ],
            "text": "the default cell as authored"
          },
          "appearance": {
            "type": "cdl:appearance",
            "on": [
              "var",
              "varGrp"
            ],
            "text": "the appearance cell, lowercased"
          },
          "parameters": {
            "type": "cdl:parameters",
            "on": [
              "var",
              "varGrp"
            ],
            "text": "the parameters not in a standard element, space-separated key=value; a range's start and end as authored (valrng/range has them too)"
          },
          "hint": {
            "type": "cdl:hint",
            "on": [
              "varGrp[@type='section' or @type='grid']"
            ],
            "localized": true
          },
          "exclusive": {
            "type": "cdl:exclusive",
            "on": [
              "varGrp[@type='multipleResp']"
            ],
            "text": "the exclusive choices' codes, space-separated"
          },
          "setting": {
            "type": "cdl:setting",
            "on": [
              "stdyDscr"
            ],
            "subject": "the settings key",
            "text": "the value of every string or number setting DDI has no element for (id_string too: IDNo is form_id's), default_language as authored (codeBook/@xml:lang is also set without one: a LimeSurvey survey's language, a multilingual form's first)",
            "standard": [
              "form_title",
              "form_id",
              "version"
            ]
          },
          "list": {
            "type": "cdl:list",
            "on": [
              "var",
              "varGrp"
            ],
            "text": "the choice list's name, when it isn't the question's own name (a grid member's: its grid's)"
          },
          "or_other": {
            "type": "cdl:or_other",
            "on": [
              "varGrp[@type='other']"
            ],
            "text": "the pair's other choice and companion question were added, not authored: 'shorthand' from the XLSForm type cell's or_other, 'added' from a source that only says the question has one (LimeSurvey's other=Y), whose XLSForm writes the explicit pair"
          },
          "note_names": {
            "type": "cdl:note_names",
            "on": [
              "var",
              "varGrp"
            ],
            "text": "the names of the note rows whose texts the preQTxt (or a group's untyped notes) joins with a blank line, space-separated, in order"
          },
          "row": {
            "type": "cdl:row",
            "on": [
              "stdyDscr"
            ],
            "subject": "the row's name",
            "text": "the type cell of a row with no data column: a metadata row (convention:unregisteredRows metadataRowTypes: start, deviceid, …) or a matrix header (an appearance with carriesData false)"
          },
          "row_label": {
            "type": "cdl:row_label",
            "on": [
              "stdyDscr"
            ],
            "subject": "the row's name",
            "localized": true,
            "text": "a cdl:row's label"
          },
          "row_hint": {
            "type": "cdl:row_hint",
            "on": [
              "stdyDscr"
            ],
            "subject": "the name of a note row or cdl:row",
            "localized": true,
            "text": "its hint"
          },
          "row_relevant": {
            "type": "cdl:row_relevant",
            "on": [
              "stdyDscr"
            ],
            "subject": "the name of a note row or cdl:row",
            "text": "its relevant (XLSForm XPath)"
          },
          "row_appearance": {
            "type": "cdl:row_appearance",
            "on": [
              "stdyDscr"
            ],
            "subject": "the name of a note row or cdl:row",
            "text": "its appearance"
          },
          "position": {
            "type": "cdl:position",
            "on": [
              "stdyDscr"
            ],
            "subject": "the name of an intro/outro note or a cdl:row, or the path of a group with no data question",
            "text": "where it is: in=<the varGrp/@name of its group, empty at the top> after=<the item before it in that group, empty when first>"
          },
          "language": {
            "type": "cdl:language",
            "on": [
              "stdyDscr"
            ],
            "subject": "a language's BCP 47 tag",
            "text": "the form's own name for it (its column suffix, 'Deutsch (de)'): every language of a form in several, in the form's order; of a form in one, when its name isn't the bare tag"
          },
          "other_label": {
            "type": "cdl:other_label",
            "on": [
              "varGrp[@type='other']"
            ],
            "localized": true,
            "text": "a select_multiple's authored other choice's label: the pair has no binary var for it"
          }
        },
        "fields": {
          "ItemBase.name": {
            "ddi": "var/@name; a group's path in varGrp/@name; a note's in cdl:note_names or notes/@subject"
          },
          "ItemBase.label": {
            "ddi": "qstn/qstnLit; a group's varGrp/txt"
          },
          "ItemBase.hint": {
            "ddi": "qstn/postQTxt; a group's in a cdl:hint note (varGrp has no hint element)",
            "note": "CDL uses postQTxt for the hint shown to respondents with the question, though the XSD describes it as text about what follows the question: DDI 2.5 has no hint element. A note row's hint is a cdl:row_hint."
          },
          "ItemBase.relevant": {
            "ddi": "universe + cdl:relevant note (convention:logicMapping)"
          },
          "ItemBase.appearance": {
            "cdlNote": "cdl:appearance",
            "note": "On a var (a select_multiple's or pair's on its varGrp), and on a section; a grid's table-list is its type='grid', so only a grid appearance other than that is noted."
          },
          "ItemBase.row": {
            "loss": "Columns the model does not lift (media, calculation, …) are not carried."
          },
          "GroupItem.kind": {
            "ddi": "a group is a varGrp"
          },
          "GroupItem.children": {
            "ddi": "varGrp/@var and @varGrp (nesting), var element order and qstn/@seqNo (order)"
          },
          "GroupItem.closed": {
            "loss": "Every group read back is closed."
          },
          "QuestionItem.kind": {
            "ddi": "a question is a var (a select_multiple: a varGrp of binary vars)"
          },
          "QuestionItem.type": {
            "ddi": "qstn/@responseDomainType, var/@intrvl, varFormat/@type, varFormat/@category (date, time), var/@dcml='0' (integer)"
          },
          "QuestionItem.rawType": {
            "ddi": "type, list and the other pattern; the or_other shorthand: cdl:or_other"
          },
          "QuestionItem.list": {
            "cdlNote": "cdl:list",
            "note": "Only when the list isn't named after the question (a grid member: after its grid); without it the list has that name. DDI that isn't CDL gets identical category sets as one list."
          },
          "QuestionItem.file": {
            "ddi": "concept/@vocab (the file is <vocab>.csv)"
          },
          "QuestionItem.orOther": {
            "ddi": "varGrp[@type='other'] (convention:other), with cdl:or_other when it was the shorthand"
          },
          "QuestionItem.guidanceHint": {
            "ddi": "qstn/ivuInstr"
          },
          "QuestionItem.constraint": {
            "ddi": "cdl:constraint note, plus valrng/range for a simple numeric range (convention:logicMapping)"
          },
          "QuestionItem.constraintMessage": {
            "cdlNote": "cdl:constraint_message",
            "note": "One per language (convention:logicMapping)."
          },
          "QuestionItem.required": {
            "cdlNote": "cdl:required"
          },
          "QuestionItem.default": {
            "cdlNote": "cdl:default"
          },
          "QuestionItem.parameters": {
            "ddi": "range start/end: valrng/range @min/@max; guidance_hint: qstn/ivuInstr; the other parameters (step, randomize, …) in a cdl:parameters note"
          },
          "QuestionItem.otherLabel": {
            "ddi": "the other answer's catgry/labl and the companion's qstnLit"
          },
          "InstrumentChoice.name": {
            "ddi": "catgry/catValu"
          },
          "InstrumentChoice.label": {
            "ddi": "catgry/labl, one per language"
          },
          "InstrumentChoice.row": {
            "ddi": "exclusive: a cdl:exclusive note on the select_multiple's varGrp listing the codes",
            "note": "The choice sheet's other columns are not carried."
          },
          "Instrument.languages": {
            "ddi": "xml:lang siblings of every text (convention:languageTagging); a language's own name in a cdl:language note"
          },
          "Instrument.defaultLanguage": {
            "ddi": "codeBook/@xml:lang"
          },
          "Instrument.settings": {
            "ddi": "form_title: titl (+ parTitl); form_id: IDNo; version: verStmt/version; every other setting, default_language as authored too: stdyDscr/notes[@type='cdl:setting'][@subject=<key>]",
            "note": "Settings that are neither a string nor a number are not carried."
          },
          "Instrument.lists": {
            "ddi": "catgry of each var that uses a list"
          },
          "Instrument.body": {
            "ddi": "dataDscr: varGrp and var, in survey order; note rows in preQTxt (names: cdl:note_names) or as stdyDscr notes type='instruction'; rows without data as cdl:row; their fields in cdl:row_*; where the stdyDscr ones are: cdl:position"
          }
        }
      }
    }
  ]
}
