{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://civic-data.de/survey/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "type": "https://civic-data.de/survey/type/",
    "variant": "https://civic-data.de/survey/variant/",
    "composite": "https://civic-data.de/survey/composite/",
    "appearance": "https://civic-data.de/survey/appearance/",
    "convention": "https://civic-data.de/survey/convention/",
    "vocab": "https://civic-data.de/survey/vocab/",
    "meta": "https://civic-data.de/survey/meta/",
    "classes": {
      "@id": "meta:classes",
      "@type": "@json"
    },
    "relations": {
      "@id": "meta:relations",
      "@type": "@json"
    },
    "rule": {
      "@id": "https://civic-data.de/survey/rule",
      "@type": "@json"
    }
  },
  "@graph": [
    {
      "@id": "convention:sanitization",
      "@type": "GlobalConvention",
      "skos:prefLabel": "Name & Choice Code Sanitization",
      "rule": {
        "name": {
          "maxLength": 20,
          "transliterate": {
            "ä": "ae",
            "ö": "oe",
            "ü": "ue",
            "Ä": "Ae",
            "Ö": "Oe",
            "Ü": "Ue",
            "ß": "ss"
          },
          "stripDiacritics": true,
          "stripCharsRegex": "[^a-zA-Z0-9]",
          "pattern": "^[a-zA-Z0-9]+$",
          "dedupStrategy": "numeric-suffix"
        },
        "choiceCode": {
          "maxLength": 5,
          "transliterate": {
            "ä": "ae",
            "ö": "oe",
            "ü": "ue",
            "Ä": "Ae",
            "Ö": "Oe",
            "Ü": "Ue",
            "ß": "ss"
          },
          "stripDiacritics": true,
          "stripCharsRegex": "[^a-zA-Z0-9]",
          "pattern": "^[a-zA-Z0-9]+$"
        },
        "order": "transliterate, then (if stripDiacritics) NFKD-decompose and drop combining marks, then delete every stripCharsRegex match, then truncate to maxLength. The result always matches `pattern`; an input with no letter or digit left is an error, not an empty name."
      }
    }
  ]
}
