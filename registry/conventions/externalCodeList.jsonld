{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://civic-data.de/survey/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "type": "https://civic-data.de/survey/type/",
    "variant": "https://civic-data.de/survey/variant/",
    "composite": "https://civic-data.de/survey/composite/",
    "appearance": "https://civic-data.de/survey/appearance/",
    "convention": "https://civic-data.de/survey/convention/",
    "vocab": "https://civic-data.de/survey/vocab/",
    "meta": "https://civic-data.de/survey/meta/",
    "classes": {
      "@id": "meta:classes",
      "@type": "@json"
    },
    "relations": {
      "@id": "meta:relations",
      "@type": "@json"
    },
    "rule": {
      "@id": "https://civic-data.de/survey/rule",
      "@type": "@json"
    }
  },
  "@graph": [
    {
      "@id": "convention:externalCodeList",
      "@type": "GlobalConvention",
      "skos:prefLabel": "External code list (long-list) pattern",
      "rule": {
        "xlsformTypePattern": "^select_(one|multiple)_from_file (?P<filename>[^ ]+\\.csv)$",
        "ddiVocabFromFilename": "stripExtension",
        "ddiEmission": "concept[@vocab='<vocab>'] in place of inline catgry; catgry MUST NOT be emitted",
        "limesurveyEmission": "base select (L/M) with the vocabulary's options inlined as A/SQ rows + cssclass='cdlvocab-<vocab>' carrying provenance (a registered LimeSurvey question attribute, so it survives import). appearance minimal or autocomplete makes a select_one a dropdown (!) instead of a radio list",
        "limesurveyCssClassPrefix": "cdlvocab-",
        "limesurveyCssClassPurpose": "A machine hook, not styling: it records which vocabulary the options came from (the way back reads it as select_*_from_file <vocab>.csv), and it is where a LimeSurvey theme can attach a searchable dropdown to a long list (`.cdlvocab-<vocab> select`). formtransform ships no such theme",
        "limesurveyCodes": {
          "rule": "An option code that already fits LimeSurvey (convention:sanitization choiceCode: pattern and maxLength) is kept. Every other one gets a code derived from the code itself, never from its row: hash(code) in base 36, maxLength characters. The codes are the same whatever the order of the file or which rows are added or removed; a collision (with a kept code or an earlier hashed one, case-insensitively, codes taken in sorted order) re-hashes `<code><collisionSeparator><n>`, n = 1, 2, …",
          "hash": "fnv1a32",
          "alphabet": "0123456789abcdefghijklmnopqrstuvwxyz",
          "collisionSeparator": "#",
          "mapping": "Each derived code is recorded in convention:lstsvMapping, and the CLI writes that mapping beside the TSV, so lstsv2ddi and its --data give back the file's own codes"
        },
        "structuralNote": "select_multiple_from_file emits a flat <var> with concept/@vocab, NOT a varGrp[@type='multipleResp'] with binary children. This differs from select_multiple.",
        "appliesTo": [
          "select_one_from_file",
          "select_multiple_from_file"
        ],
        "vocabularyCsvHeader": "code,label",
        "vocabularyDeclaration": "Vocabularies are open-ended: this convention defines only how one is declared and handled, never which ones exist. To add one, put its options in registry/vocab/<name>.csv with a 'code,label' header and add a '@type': 'Vocabulary' node to the graph with xlsformFilename/ddiVocab/vocabURI/standard/skos:prefLabel. Every consumer discovers vocabularies by filtering '@type' == 'Vocabulary', so no code, convention or emitter needs editing. vocab:iso_3166_1 is one example, not a special case."
      }
    }
  ]
}
