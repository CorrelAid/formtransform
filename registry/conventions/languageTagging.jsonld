{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://civic-data.de/survey/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "type": "https://civic-data.de/survey/type/",
    "variant": "https://civic-data.de/survey/variant/",
    "composite": "https://civic-data.de/survey/composite/",
    "appearance": "https://civic-data.de/survey/appearance/",
    "convention": "https://civic-data.de/survey/convention/",
    "vocab": "https://civic-data.de/survey/vocab/",
    "meta": "https://civic-data.de/survey/meta/",
    "classes": {
      "@id": "meta:classes",
      "@type": "@json"
    },
    "relations": {
      "@id": "meta:relations",
      "@type": "@json"
    },
    "rule": {
      "@id": "https://civic-data.de/survey/rule",
      "@type": "@json"
    }
  },
  "@graph": [
    {
      "@id": "convention:languageTagging",
      "@type": "GlobalConvention",
      "skos:prefLabel": "XLSForm `label::<lang>` ↔ LS TSV `language` cell ↔ DDI `xml:lang`",
      "rule": {
        "xlsformColumnPattern": "^(?P<base>label|hint|constraint_message|guidance_hint|media::image|media::audio|media::video)::(?P<lang>.+)$",
        "xlsformLanguageList": {
          "setting": "settings.default_language",
          "fallback": "first language encountered in label columns",
          "note": "Each language code MUST be a well-formed IETF BCP 47 tag (e.g. 'de', 'en', 'fr-BE', 'zh-Hans'), written either bare (label::fr-BE) or in parentheses after a name (label::Français (fr-BE)). Tools reject malformed tags; they never drop a language column silently."
        },
        "lsTsvHandling": {
          "column": "language",
          "emission": "one row per language per question — same name/type, different language column + text/help cells",
          "baseLanguage": "first emitted; subsequent languages reference same question name",
          "limesurveyLanguages": {
            "source": "LimeSurvey 6.16.4 application/helpers/surveytranslator_helper.php",
            "codes": [
              "af",
              "sq",
              "am",
              "ar",
              "hy",
              "az",
              "eu",
              "be",
              "bn",
              "bs",
              "bg",
              "ca-valencia",
              "ca",
              "ceb",
              "ny",
              "zh-Hans",
              "hat",
              "zh-Hant-HK",
              "zh-Hant-TW",
              "hr",
              "cs",
              "cs-informal",
              "da",
              "prs",
              "nl",
              "nl-informal",
              "en",
              "et",
              "fil",
              "fi",
              "fr",
              "ful",
              "gl",
              "ka",
              "de",
              "de-easy",
              "de-informal",
              "gu",
              "el",
              "kal",
              "haz",
              "ha",
              "he",
              "hi",
              "hil",
              "hu",
              "hu-informal",
              "is",
              "id",
              "ike",
              "ie",
              "ilo",
              "it",
              "it-informal",
              "ja",
              "kn",
              "kk",
              "rw",
              "ko",
              "km",
              "run",
              "ckb",
              "kmr",
              "ky",
              "lv",
              "lt",
              "lb",
              "mk",
              "ms",
              "ml",
              "mt",
              "mr",
              "mn",
              "cnr",
              "mya",
              "nb",
              "ne",
              "nn",
              "oc",
              "ory",
              "ps",
              "fa",
              "pap-CW",
              "pl",
              "pl-informal",
              "pt",
              "pt-BR",
              "pa",
              "ro",
              "roh",
              "ru",
              "smi",
              "sr",
              "sr-Latn",
              "si",
              "sk",
              "sl",
              "so",
              "es",
              "es-informal",
              "es-AR",
              "es-AR-informal",
              "es-CL",
              "es-CO",
              "es-MX",
              "swh",
              "sv",
              "tl",
              "tg",
              "ta",
              "te",
              "th",
              "ti",
              "tr",
              "uk",
              "ur",
              "uz",
              "ug",
              "vi",
              "cy",
              "xho",
              "sah",
              "yor",
              "zu"
            ]
          },
          "mapping": [
            "1. A tag equal to a LimeSurvey code (case-insensitive) is that code: pt-br → pt-BR, de-informal → de-informal.",
            "2. Else a listed alias: the BCP 47 form of a code LimeSurvey spells differently.",
            "3. Else the tag's primary language subtag, if that is a code (fr-BE → fr, de-AT → de), with a warning: the regional form is lost.",
            "4. Else the conversion fails (error). Two tags that map to the same code fail too."
          ],
          "aliases": {
            "zh": "zh-Hans",
            "zh-CN": "zh-Hans",
            "zh-SG": "zh-Hans",
            "zh-Hans-CN": "zh-Hans",
            "zh-TW": "zh-Hant-TW",
            "zh-Hant": "zh-Hant-TW",
            "zh-HK": "zh-Hant-HK",
            "zh-MO": "zh-Hant-HK",
            "ca-ES-valencia": "ca-valencia",
            "ht": "hat",
            "ff": "ful",
            "kl": "kal",
            "iu": "ike",
            "rn": "run",
            "ku": "kmr",
            "my": "mya",
            "no": "nb",
            "or": "ory",
            "rm": "roh",
            "se": "smi",
            "sw": "swh",
            "xh": "xho",
            "yo": "yor",
            "sr-Cyrl": "sr",
            "sr-Latn-RS": "sr-Latn",
            "pap": "pap-CW"
          }
        },
        "ddiHandling": {
          "attribute": "xml:lang",
          "appliesToElements": [
            "txt",
            "qstnLit",
            "labl",
            "preQTxt",
            "postQTxt"
          ],
          "emission": "one child element per language with xml:lang attr",
          "implemented": "partly: the base language (settings.default_language) is declared as codeBook/@xml:lang and its text is emitted; the other languages' elements are not emitted yet (formtransform#135)"
        }
      }
    }
  ]
}
