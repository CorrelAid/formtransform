{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://civic-data.de/survey/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "type": "https://civic-data.de/survey/type/",
    "variant": "https://civic-data.de/survey/variant/",
    "composite": "https://civic-data.de/survey/composite/",
    "appearance": "https://civic-data.de/survey/appearance/",
    "convention": "https://civic-data.de/survey/convention/",
    "vocab": "https://civic-data.de/survey/vocab/",
    "meta": "https://civic-data.de/survey/meta/",
    "classes": {
      "@id": "meta:classes",
      "@type": "@json"
    },
    "relations": {
      "@id": "meta:relations",
      "@type": "@json"
    },
    "rule": {
      "@id": "https://civic-data.de/survey/rule",
      "@type": "@json"
    }
  },
  "@graph": [
    {
      "@id": "convention:choiceFilter",
      "@type": "GlobalConvention",
      "skos:prefLabel": "Choice filter on an earlier multiple choice",
      "rule": {
        "surveyColumn": "choice_filter",
        "selectedFunction": "selected",
        "pattern": "selected(${<q>}, <column>): show only the options whose <column> cell (on the choices sheet) is ticked in <q>",
        "filterTypes": [
          "select_multiple"
        ],
        "appliesTo": [
          "select_one",
          "select_multiple"
        ],
        "codeColumn": "name",
        "limesurveyAttribute": "array_filter",
        "limesurveyEmission": "array_filter = <q>'s LimeSurvey name. LimeSurvey then shows an option only when <q>'s subquestion with the same code is ticked, so every option's <column> value must be one of <q>'s answer codes, each at most once",
        "recode": "With <column> = name the codes already match. With another column, the filtered question's LimeSurvey answer codes are its <column> values (a `choice-filter-recoded` warning): LimeSurvey stores those codes for this question, not the list's names",
        "unconvertible": "any other choice_filter, a <q> that is no select_multiple, or <column> values that are no answer code of <q> (or repeat one): the filter is dropped with a `choice-filter-dropped` warning, and LimeSurvey shows every option",
        "reverse": "array_filter = <q> on a LimeSurvey list or multiple choice comes back as choice_filter selected(${<q>}, name)"
      }
    }
  ]
}
