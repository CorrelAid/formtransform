{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://civic-data.de/survey/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "type": "https://civic-data.de/survey/type/",
    "variant": "https://civic-data.de/survey/variant/",
    "composite": "https://civic-data.de/survey/composite/"
  },
  "@graph": [
    {
      "@id": "type:date",
      "@type": "QuestionType",
      "skos:prefLabel": "Date",
      "xlsform": {
        "typeString": "date"
      },
      "limesurvey": {
        "typeCode": "D",
        "supportsOther": false,
        "answerClass": null
      },
      "ddi": {
        "intrvl": "discrete",
        "formatType": "character",
        "responseDomainType": "text"
      },
      "kobo": {
        "nativeSupport": true
      },
      "constraints": {
        "maxNameLength": 20,
        "namePattern": "^[a-zA-Z0-9]+$"
      },
      "tests": [
        "tests/types/date/"
      ],
      "exampleDir": "registry/entities/date",
      "examplePath": "registry/entities/date/xlsform.json",
      "useWhen": "When capturing a specific calendar date (e.g. date of birth, appointment date)."
    }
  ]
}