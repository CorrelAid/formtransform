  },
  "@graph": [
    {
      "@id": "variant:select_one_long_list",
      "@type": "QuestionTypeVariant",
      "skos:prefLabel": "Select One (Long List)",
      "skos:broader": {
        "@id": "type:select_one"
      },
      "presentation": {
        "appearanceString": "minimal",
        "withOther": false,
        "withLongList": true
      },
      "examplePath": "registry/entities/select_one_long_list/xlsform.json",
      "exampleDir": "registry/entities/select_one_long_list",
      "useWhen": "When selecting one answer from a long closed list (typically 15+ options) such as countries or occupations, where a dropdown or autocomplete interface is preferable to many radio buttons."
    }
  ]
