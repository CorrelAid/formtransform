{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://civic-data.de/survey/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "type": "https://civic-data.de/survey/type/",
    "variant": "https://civic-data.de/survey/variant/",
    "composite": "https://civic-data.de/survey/composite/"
  },
  "@graph": [
    {
      "@id": "type:decimal",
      "@type": "QuestionType",
      "skos:prefLabel": "Decimal/Float",
      "xlsform": {
        "typeString": "decimal"
      },
      "limesurvey": {
        "typeCode": "N",
        "supportsOther": false,
        "answerClass": null
      },
      "ddi": {
        "intrvl": "contin",
        "formatType": "numeric",
        "responseDomainType": "numeric"
      },
      "kobo": {
        "nativeSupport": true
      },
      "constraints": {
        "maxNameLength": 20,
        "namePattern": "^[a-zA-Z0-9]+$"
      },
      "exampleDir": "registry/entities/decimal",
      "examplePath": "registry/entities/decimal/xlsform.json",
      "useWhen": "When collecting open decimal numeric values without predefined categories (e.g. height in metres, temperature)."
    }
  ]
}