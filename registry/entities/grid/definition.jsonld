{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://civic-data.de/survey/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "prefLabelDe": {
      "@id": "skos:prefLabel",
      "@language": "de"
    },
    "type": "https://civic-data.de/survey/type/",
    "variant": "https://civic-data.de/survey/variant/",
    "composite": "https://civic-data.de/survey/composite/"
  },
  "@graph": [
    {
      "@id": "composite:grid",
      "@type": "Composite",
      "skos:prefLabel": "Grid / Matrix Group",
      "prefLabelDe": "Matrix-Gruppe",
      "skos:broader": [
        {
          "@id": "type:begin_group"
        },
        {
          "@id": "type:select_one"
        },
        {
          "@id": "type:integer"
        },
        {
          "@id": "type:decimal"
        },
        {
          "@id": "type:range"
        }
      ],
      "trigger": {
        "appearance": "table-list",
        "xlsformPattern": "begin_group row with appearance=table-list",
        "applyTo": "begin_group + all rows until matching end_group"
      },
      "input": {
        "rows": [
          {
            "role": "header",
            "match": "type=begin_group, appearance=table-list",
            "cardinality": 1
          },
          {
            "role": "item",
            "match": "type=select_one <listname> — all items MUST share the same listname; or, for a table of numbers, every item type=integer, decimal or range. Items of other types, or a mix of both kinds, make the group a section instead.",
            "cardinality": "1..*"
          },
          {
            "role": "closer",
            "match": "type=end_group",
            "cardinality": 1
          }
        ]
      },
      "output": {
        "ddi": {
          "container": "varGrp[@type='grid']",
          "containerAttrs": {
            "name": "<group name>",
            "var": "space-separated member IDs"
          },
          "memberVars": "one <var> per item row, all of one response domain (the skos:broader QuestionTypes': 'category' or 'numeric'). A choice grid's vars each carry the full <catgry> set repeated (responseDomainType='category'); a table of numbers' vars are numeric (responseDomainType='numeric'). Each member's qstn/preQTxt is the group's txt, in every language: the question printed once above the rows (formtransform#174)."
        },
        "lsTsv": {
          "headerRow": "F-type question (matrix header) with answerClass=A; answer codes from shared list",
          "itemRows": "SQ-class rows, one per item",
          "note": "LS represents the matrix as a single question with sub-questions; categories not re-emitted per row",
          "numericRows": "A table of numbers is no LimeSurvey array: an ordinary group (G row with the group's label) with one question per row. LimeSurvey reads it back as a field-list group, not a table-list one."
        }
      },
      "schematronPatterns": [
        "essentials",
        "logic"
      ],
      "notes": [
        "If `appearance=table-list` is absent, the group is flattened — children become top-level vars in DDI, group is lost.",
        "Items SHOULD share the same `listname` so the matrix is rectangular.",
        "A table of number fields under one printed question (e.g. employees: total, then by sex) is a table-list group of integer/decimal/range rows, not a note followed by rows: the note would be the preQTxt of the first row only (formtransform#174). A note row between two rows (\"davon: …\") stays one note: a cdl:grid_note on the grid."
      ],
      "exampleDir": "registry/entities/grid",
      "examplePath": "registry/entities/grid/xlsform.json",
      "useWhen": "When multiple survey items share the same response scale and introductory text, forming a battery (e.g. a Likert scale measuring agreement across several statements), or when one question asks for several numbers in a small table (e.g. employees in total and by sex)."
    }
  ]
}
