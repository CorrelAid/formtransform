{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["uv"],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  },
  "workspaces": {
    ".": {
      "entry": ["src/generateFixtures.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/generated/**"]
    },
    "docs": {
      "ignoreDependencies": ["@registry/.*"]
    }
  }
}
